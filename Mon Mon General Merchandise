<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Divine J Business Portal</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #000;
    }
    iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }
    /* Overlay button to trigger fullscreen via tap */
    .fullscreen-btn {
      position: fixed;
      bottom: 20px;
      right: 20px;
      z-index: 9999;
      background-color: rgba(0, 0, 0, 0.7);
      color: #fff;
      border: 1px solid #fff;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 14px;
      font-family: sans-serif;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <button id="fsBtn" class="fullscreen-btn">Fullscreen</button>

  <iframe 
    id="portalIframe"
    src="https://script.google.com/macros/s/AKfycbxY_28gIXYnInHkyr-_JGQ76KF2yRStRTjwhZ765o3hkWlmDr9JFbW3JwjM02JUHq_v/exec"
    allow="fullscreen"
    allowfullscreen>
  </iframe>

  <script>
    const fsBtn = document.getElementById('fsBtn');
    const iframe = document.getElementById('portalIframe');

    // Fullscreen must be triggered by a direct user gesture (tap/click)
    fsBtn.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        if (iframe.requestFullscreen) {
          iframe.requestFullscreen();
        } else if (iframe.webkitRequestFullscreen) { /* Safari / iOS support */
          iframe.webkitRequestFullscreen();
        }
      } else {
        if (document.exitFullscreen) {
          document.exitFullscreen();
        }
      }
    });

    // Hide button once in fullscreen mode
    document.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement) {
        fsBtn.style.display = 'none';
      } else {
        fsBtn.style.display = 'block';
      }
    });
  </script>
</body>
</html>
